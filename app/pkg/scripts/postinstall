#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-only
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$SCRIPT_DIR/common.sh"

require_target "${3:-}"
check_bundle_tree
rtw_verify_app "$APP" || fail "The installed app and helper must have valid ad-hoc signatures."
bundle_is_protected || fail "Incorrect installed app permissions; root ownership without group/other write access is required."
log "The complete, protected app was installed at $APP."
log "No kernel extension, password or security policy was modified."
if identify_console_user; then
    if run_as_console_user /usr/bin/open "$APP" --args --complete-install; then
        log "Launch requested in the user session. Pending approvals must be confirmed in System Settings."
    else
        # The payload is installed correctly. GUI launch is not an installation failure.
        log "WARNING: open Tahoe Wi-Fi USB in Applications to complete setup."
    fi
else
    log "No graphical session: open Tahoe Wi-Fi USB in Applications after signing in."
fi
exit 0
